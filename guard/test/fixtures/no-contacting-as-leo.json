[
  {"name": "Slack send tool", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__claude_ai_Slack__slack_send_message", "tool_input": {"channel_id": "C123", "message": "hi all"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Slack scheduled message", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__claude_ai_Slack__slack_schedule_message", "tool_input": {"channel_id": "C123", "message": "hi", "post_at": 1760000000}, "cwd": "$HOME/Jarvis"}},
  {"name": "Gmail send", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__claude_ai_Gmail__send_email", "tool_input": {"to": ["mum@example.com"], "subject": "hi", "body": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Gmail send an existing draft", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__claude_ai_Gmail__send_draft", "tool_input": {"draft_id": "r-1"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Calendar RSVP", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__Google_Calendar__respond_to_event", "tool_input": {"eventId": "e1", "response": "accepted"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Calendar event with attendees sends invites", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__Google_Calendar__create_event", "tool_input": {"summary": "Study", "attendees": ["sue@soton.ac.uk"]}, "cwd": "$HOME/Jarvis"}},
  {"name": "Board share invites people", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__Miro__board_share", "tool_input": {"board_id": "b", "emails": ["x@y.com"]}, "cwd": "$HOME/Jarvis"}},
  {"name": "GitHub comment as Leo", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__github__add_issue_comment", "tool_input": {"owner": "a", "repo": "b", "issue_number": 1, "body": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Design comment", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "mcp__Canva__comment-on-design", "tool_input": {"design_id": "d", "message_plaintext": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "AppleScript Messages send", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "osascript -e 'tell application \"Messages\" to send \"on my way\" to buddy \"Mum\"'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "AppleScript Mail send via heredoc", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "osascript <<'EOF'\ntell application \"Mail\"\n  set m to make new outgoing message with properties {subject:\"hi\", content:\"x\"}\n  tell m to make new to recipient with properties {address:\"sue@example.com\"}\n  send m\nend tell\nEOF"}, "cwd": "$HOME/Jarvis"}},
  {"name": "UI scripting WhatsApp", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "osascript -e 'tell application \"WhatsApp\" to activate' -e 'tell application \"System Events\" to keystroke \"hello\"' -e 'tell application \"System Events\" to key code 36'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "FaceTime call", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "open facetime://+447700900123"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Phone call link", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "open 'tel:+447700900123'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "sendmail", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "printf 'Subject: hi\\n\\nx' | sendmail sue@example.com"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Slack webhook from the shell", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "curl -X POST -d '{\"text\":\"hi\"}' https://hooks.slack.com/services/T0/B0/xyz"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Python smtplib", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "python3 -c 'import smtplib; s=smtplib.SMTP(\"smtp.gmail.com\"); s.sendmail(\"a\",\"b\",\"c\")'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "gh pr comment", "expect": "deny", "rule": "no-contacting-as-leo",
   "input": {"tool_name": "Bash", "tool_input": {"command": "gh pr comment 12 --body 'lgtm'"}, "cwd": "$REPO"}}
]
