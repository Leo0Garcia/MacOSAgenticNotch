[
  {"name": "Weather lookup", "expect": "allow",
   "input": {"tool_name": "WebFetch", "tool_input": {"url": "https://wttr.in/Southampton?format=3", "prompt": "weather"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Weather via curl", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "curl -s 'https://api.open-meteo.com/v1/forecast?latitude=50.9&longitude=-1.4&current=temperature_2m'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Web search", "expect": "allow",
   "input": {"tool_name": "WebSearch", "tool_input": {"query": "weather in Southampton today"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Read-only market data", "expect": "allow",
   "input": {"tool_name": "WebFetch", "tool_input": {"url": "https://finance.yahoo.com/quote/AAPL/"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Trading MCP read-only quote", "expect": "allow",
   "input": {"tool_name": "mcp__Co-Invest__analyze_market", "tool_input": {"symbol": "BTC"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Trading MCP portfolio read", "expect": "allow",
   "input": {"tool_name": "mcp__Co-Invest__get_portfolio", "tool_input": {}, "cwd": "$HOME/Jarvis"}},
  {"name": "Moodle read in Chrome", "expect": "allow",
   "input": {"tool_name": "mcp__claude-in-chrome__navigate", "tool_input": {"url": "https://moodle.ecs.soton.ac.uk/my/courses.php", "tabId": 3}, "cwd": "$HOME/Jarvis"}},
  {"name": "Moodle page text", "expect": "allow",
   "input": {"tool_name": "mcp__claude-in-chrome__get_page_text", "tool_input": {"tabId": 3}, "cwd": "$HOME/Jarvis"}},
  {"name": "University course page", "expect": "allow",
   "input": {"tool_name": "WebFetch", "tool_input": {"url": "https://www.southampton.ac.uk/courses/computer-science-degree-bsc"}, "cwd": "$HOME/Jarvis"}},
  {"name": "NHS health information page", "expect": "allow",
   "input": {"tool_name": "WebFetch", "tool_input": {"url": "https://www.nhs.uk/conditions/flu/"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Kanban edit", "expect": "allow",
   "input": {"tool_name": "Edit", "tool_input": {"file_path": "$VAULT/Kanban.md", "old_string": "## Not Started\n", "new_string": "## Not Started\n\n- [ ] buy chalk\n"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Kanban atomic write via temp and rename", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "cat > \"$VAULT/.Kanban.md.jarvis.tmp\" <<'EOF'\n---\nkanban-plugin: board\n---\nEOF\nmv \"$VAULT/.Kanban.md.jarvis.tmp\" \"$VAULT/Kanban.md\""}, "cwd": "$HOME/Jarvis"}},
  {"name": "Kanban through the Obsidian MCP", "expect": "allow",
   "input": {"tool_name": "mcp__obsidian__patch_note", "tool_input": {"path": "Kanban.md", "oldString": "a", "newString": "b"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Read a master vault note", "expect": "allow",
   "input": {"tool_name": "Read", "tool_input": {"file_path": "$VAULT/Uni/COMP1234.md"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Obsidian MCP read", "expect": "allow",
   "input": {"tool_name": "mcp__obsidian__read_note", "tool_input": {"path": "Uni/COMP1234.md"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Slack read", "expect": "allow",
   "input": {"tool_name": "mcp__claude_ai_Slack__slack_read_channel", "tool_input": {"channel_id": "C123"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Slack draft (shown to Leo, not sent)", "expect": "allow",
   "input": {"tool_name": "mcp__claude_ai_Slack__slack_send_message_draft", "tool_input": {"channel_id": "C123", "message": "draft"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Gmail draft", "expect": "allow",
   "input": {"tool_name": "mcp__claude_ai_Gmail__create_draft", "tool_input": {"to": ["sue@example.com"], "body": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Calendar event without attendees", "expect": "allow",
   "input": {"tool_name": "mcp__Google_Calendar__create_event", "tool_input": {"summary": "Revise COMP1234", "start": "2026-10-12T10:00:00Z"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Apple Calendar read", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "osascript -e 'tell application \"Calendar\" to get summary of every event of calendar \"Home\"'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Mail draft via AppleScript (not sent)", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "osascript -e 'tell application \"Mail\" to make new outgoing message with properties {subject:\"hi\", visible:true}'"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Jarvis's own Keychain item", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "curl -s \"$(security find-generic-password -s jarvis/uni-ical -w)\" -o ~/Jarvis/cache/uni.ics"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Open an app", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "open -a Spotify"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Find files", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "find ~/Documents -name '*.pdf' -mtime -7"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Rename a file (no overwrite)", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "mv ~/Downloads/report.pdf ~/Downloads/2026-10-11-report.pdf"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Create a new file outside", "expect": "allow",
   "input": {"tool_name": "Write", "tool_input": {"file_path": "$HOME/Documents/new-notes.md", "content": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Edit a file outside (not delete)", "expect": "allow",
   "input": {"tool_name": "Edit", "tool_input": {"file_path": "$HOME/Documents/essay.md", "old_string": "teh", "new_string": "the"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Delete inside ~/Jarvis", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "rm -f ~/Jarvis/runs/old.jsonl"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Delete in the repo", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "rm -rf node_modules dist"}, "cwd": "$REPO"}},
  {"name": "Delete in temp", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "rm $TMPDIR/scratch.txt"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Overwrite a memory note", "expect": "allow",
   "input": {"tool_name": "Write", "tool_input": {"file_path": "$HOME/Jarvis-Memory/Me.md", "content": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Write briefing", "expect": "allow",
   "input": {"tool_name": "Write", "tool_input": {"file_path": "$HOME/Jarvis/briefing.md", "content": "x"}, "cwd": "$HOME/Jarvis"}},
  {"name": "git status in another repo", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "git -C ~/code/other-project status && git -C ~/code/other-project log -5"}, "cwd": "$HOME/Jarvis"}},
  {"name": "git clean in the Jarvis repo", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "git clean -fd"}, "cwd": "$REPO"}},
  {"name": "Jarvis reminder launch agent", "expect": "allow",
   "input": {"tool_name": "Bash", "tool_input": {"command": "launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.jarvis.reminder.abc.plist"}, "cwd": "$HOME/Jarvis"}},
  {"name": "A .env.example is not a secret", "expect": "allow",
   "input": {"tool_name": "Read", "tool_input": {"file_path": "$HOME/code/other-project/.env.example"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Computer-use key press", "expect": "allow",
   "input": {"tool_name": "mcp__computer-use__key", "tool_input": {"text": "cmd+space"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Bridge speak", "expect": "allow",
   "input": {"tool_name": "mcp__jarvis__speak", "tool_input": {"text": "It's 14 degrees in Southampton."}, "cwd": "$HOME/Jarvis"}},
  {"name": "Bridge remind", "expect": "allow",
   "input": {"tool_name": "mcp__jarvis__remind", "tool_input": {"when": "18:00", "text": "pay the gas bill at gov.uk"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Memory note mentioning a bank", "expect": "allow",
   "input": {"tool_name": "Write", "tool_input": {"file_path": "$HOME/Jarvis-Memory/Log/2026-10-11.md", "content": "Leo asked about barclays.co.uk opening hours"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Search the web for a bank's phone number", "expect": "allow",
   "input": {"tool_name": "WebSearch", "tool_input": {"query": "barclays customer service number"}, "cwd": "$HOME/Jarvis"}},
  {"name": "Subagent", "expect": "allow",
   "input": {"tool_name": "Agent", "tool_input": {"description": "research", "prompt": "find papers on X"}, "cwd": "$HOME/Jarvis"}}
]
